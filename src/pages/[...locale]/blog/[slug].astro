---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { collectionFor, translationsOf } from '../../../i18n/content.js';
import { useTranslations, localise, LANGS } from '../../../i18n/ui.js';
import { localePaths } from '../../../i18n/routes.js';

export async function getStaticPaths() {
  const byLang = Object.fromEntries(
    await Promise.all(LANGS.map(async (lang) => [lang, await collectionFor('blog', lang)])),
  );

  return localePaths((lang) =>
    byLang[lang].map((post) => ({ params: { slug: post.id }, props: { post } })),
  );
}

const { lang, post } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);

const covers = import.meta.glob('../../../content/blog/*/featured.{png,jpg,jpeg,webp}', {
  eager: true,
});
const cover = Object.entries(covers).find(([path]) => path.includes(`/${post.id}/`))?.[1]?.default;

const LOCALES = { en: 'en-GB', it: 'it-IT' };
const formatDate = (date) =>
  date.toLocaleDateString(LOCALES[lang], { year: 'numeric', month: 'long', day: 'numeric' });

const alternates = await translationsOf('blog', post.id, (l) => localise(`/blog/${post.id}/`, l));

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const coverUrl = cover ? new URL(cover.src, Astro.site).href : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  inLanguage: lang,
  url: pageUrl,
  ...(coverUrl ? { image: coverUrl } : {}),
  keywords: post.data.tags.join(', '),
  author: {
    '@type': 'Person',
    name: 'Stefano Blando',
    url: 'https://stefano-blando.github.io/',
    affiliation: [
      { '@type': 'CollegeOrUniversity', name: 'Scuola Superiore Sant’Anna' },
      { '@type': 'CollegeOrUniversity', name: 'University of Pisa' },
    ],
  },
};
---

<Base
  title={`${post.data.title} — Stefano Blando`}
  description={post.data.summary}
  scene={false}
  lang={lang}
  image={cover}
  alternates={alternates}
  type="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </Fragment>
  <main class="page page-article">
    <p class="index-meta">{formatDate(post.data.date)}</p>
    <h1>{post.data.title}</h1>
    <p class="page-lede">{post.data.summary}</p>

    <ul class="tag-row">
      {post.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>

    {
      cover && (
        <figure class="detail-cover">
          <Image src={cover} alt="" widths={[720, 1440]} sizes="(max-width: 900px) 92vw, 42rem" />
        </figure>
      )
    }

    <article class="prose"><Content /></article>

    <p class="back-link">
      <a href={localise('/blog/', lang)}>{t('blog.back')}</a>
    </p>
  </main>
</Base>

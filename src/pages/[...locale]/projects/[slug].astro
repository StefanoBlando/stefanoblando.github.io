---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { collectionFor, translationsOf } from '../../../i18n/content.js';
import { useTranslations, localise, LANGS } from '../../../i18n/ui.js';
import { localePaths } from '../../../i18n/routes.js';

export async function getStaticPaths() {
  const byLang = Object.fromEntries(
    await Promise.all(LANGS.map(async (lang) => [lang, await collectionFor('projects', lang)])),
  );

  return localePaths((lang) =>
    byLang[lang].map((project) => ({ params: { slug: project.id }, props: { project } })),
  );
}

const { lang, project } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(project);

// Author-supplied links: a blank url renders href="" and reloads the page.
const links = project.data.links.filter((link) => link.url);

const covers = import.meta.glob('../../../content/projects/*/featured.{png,jpg,jpeg,webp}', {
  eager: true,
});
const cover = Object.entries(covers).find(([path]) => path.includes(`/${project.id}/`))?.[1]
  ?.default;

const alternates = await translationsOf('projects', project.id, (l) =>
  localise(`/projects/${project.id}/`, l),
);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const coverUrl = cover ? new URL(cover.src, Astro.site).href : undefined;
const githubLink = links.find((l) => l.url?.includes('github.com'))?.url;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': githubLink ? 'SoftwareSourceCode' : 'CreativeWork',
  name: project.data.title,
  description: project.data.summary,
  inLanguage: lang,
  url: pageUrl,
  ...(coverUrl ? { image: coverUrl } : {}),
  ...(githubLink ? { codeRepository: githubLink } : {}),
  keywords: project.data.tags.join(', '),
  author: {
    '@type': 'Person',
    name: 'Stefano Blando',
    url: 'https://stefano-blando.github.io/',
    affiliation: [
      { '@type': 'CollegeOrUniversity', name: 'Scuola Superiore Sant’Anna' },
      { '@type': 'CollegeOrUniversity', name: 'University of Pisa' },
    ],
  },
};
---

<Base
  title={`${project.data.title} — Stefano Blando`}
  description={project.data.summary}
  scene={false}
  lang={lang}
  image={cover}
  alternates={alternates}
  type="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </Fragment>
  <main class="page page-article">
    <p class="index-meta">{t('nav.projects')}</p>
    <h1>{project.data.title}</h1>
    <p class="page-lede">{project.data.summary}</p>

    <ul class="tag-row">
      {project.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>

    {
      links.length > 0 && (
        <ul class="action-links">
          {links.map((link) => (
            <li>
              <a href={link.url}>{link.name ?? 'Link'} →</a>
            </li>
          ))}
        </ul>
      )
    }

    {
      cover && (
        <figure class="detail-cover">
          <Image src={cover} alt="" widths={[720, 1440]} sizes="(max-width: 900px) 92vw, 42rem" />
        </figure>
      )
    }

    <article class="prose"><Content /></article>

    <p class="back-link">
      <a href={localise('/projects/', lang)}>{t('projects.back')}</a>
    </p>
  </main>
</Base>

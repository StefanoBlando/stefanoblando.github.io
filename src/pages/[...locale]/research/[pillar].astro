---
import Base from '../../../layouts/Base.astro';
import pillars from '../../../data/pillars.json';
import { collectionFor } from '../../../i18n/content.js';
import { useTranslations, localise } from '../../../i18n/ui.js';
import { localePaths, alternatesFor } from '../../../i18n/routes.js';

export function getStaticPaths() {
  return localePaths(() => pillars.map((pillar) => ({ params: { pillar: pillar.id }, props: { pillar } })));
}

const { lang, pillar } = Astro.props;
const t = useTranslations(lang);

/* The works in this pillar, in the language being read: publications declare
   their pillar, the pillar names its projects. */
const publications = (await collectionFor('publications', lang)).filter(
  (entry) => entry.data.pillar === pillar.id,
);
const projects = (await collectionFor('projects', lang)).filter((entry) =>
  pillar.projects.includes(entry.id),
);

const sections = [
  { heading: t('nav.publications'), base: '/publications/', entries: publications },
  { heading: t('nav.projects'), base: '/projects/', entries: projects },
].filter((section) => section.entries.length > 0);
---

<Base
  title={`${pillar.title[lang]} — Stefano Blando`}
  description={pillar.description[lang]}
  scene={false}
  lang={lang}
  alternates={alternatesFor(`/research/${pillar.id}/`)}
>
  <main class="page">
    <p class="index-meta">
      {String(pillar.index).padStart(2, '0')} — {t('research.heading')}
    </p>
    <h1>{pillar.title[lang]}</h1>
    <p class="page-lede">{pillar.description[lang]}</p>

    <ul class="tag-row">
      {pillar.topics[lang].map((topic) => <li>{topic}</li>)}
    </ul>

    {/* The long-form paragraph the homepage used to carry, now where it can be read. */}
    <p class="pillar-detail">{pillar.detailed_text[lang]}</p>

    {
      sections.map((section) => (
        <>
          <h2 class="year-heading">{section.heading}</h2>
          <ul class="index-list">
            {section.entries.map((entry) => (
              <li>
                <a href={localise(`${section.base}${entry.id}/`, lang)}>
                  <span class="index-title">{entry.data.title}</span>
                  <span class="index-summary">{entry.data.summary}</span>
                </a>
                <ul class="tag-row">
                  {entry.data.tags.slice(0, 4).map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </>
      ))
    }

    <p class="back-link">
      <a href={localise('/research/', lang)}>{t('research.back')}</a>
    </p>
  </main>
</Base>

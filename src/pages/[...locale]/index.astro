---
import Base from '../../layouts/Base.astro';
import { buildPages } from '../../engine/pages.js';
import { useTranslations, localise } from '../../i18n/ui.js';
import { localePaths, alternatesFor } from '../../i18n/routes.js';

export function getStaticPaths() {
  return localePaths();
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * The homepage is one cloud taking eight shapes as you scroll.
 *
 * A real scrolling document, smoothed by Lenis with the reference's own
 * easing. Each page is a tall section; crossing one morphs the cloud into the
 * next topology. An earlier build stacked the pages and snapped between them
 * to control the pace — the reference turned out not to snap at all, and the
 * feel comes from the easing curve instead.
 *
 * Every page is in the markup and readable without JavaScript: a crawler, or
 * a visitor whose engine failed, gets all the destinations as a plain list.
 */
const PAGES = buildPages();

const ORCID = '0009-0007-0523-6855';
const ORCID_URL = `https://orcid.org/${ORCID}`;

/**
 * Who this site is about, in the form a search engine reads. The `sameAs`
 * list is what ties the site to the Scholar, GitHub, LinkedIn and ORCID
 * profiles as one person rather than five unrelated pages — and ORCID is the
 * one of them that a publisher or a funder will actually resolve.
 */
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Stefano Blando',
  jobTitle: 'PhD Candidate in Artificial Intelligence',
  email: 'mailto:stefano.blando@santannapisa.it',
  url: new URL('/', Astro.site).href,
  image: new URL('/media/portrait.png', Astro.site).href,
  affiliation: [
    { '@type': 'CollegeOrUniversity', name: 'Scuola Superiore Sant’Anna', url: 'https://www.santannapisa.it' },
    { '@type': 'CollegeOrUniversity', name: 'University of Pisa', url: 'https://www.unipi.it/' },
  ],
  knowsAbout: [
    'Agent-Based Modeling',
    'Multi-Agent Systems',
    'Statistical Model Checking',
    'Robust Statistics',
    'Complex Networks',
    'Economic Simulation',
  ],
  identifier: { '@type': 'PropertyValue', propertyID: 'ORCID', value: ORCID_URL },
  sameAs: [
    ORCID_URL,
    'https://github.com/stefano-blando',
    'https://www.linkedin.com/in/stefano-blando/',
    'https://scholar.google.com/citations?user=dNbRRG0AAAAJ',
  ],
};
---

<Base
  title={t('home.title')}
  description={t('home.description')}
  scene={true}
  anchorBase=""
  lang={lang}
  alternates={alternatesFor('/')}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(person)} is:inline />
  </Fragment>

  <!-- Fixed backdrop. It carries no text and nothing in it is clickable. -->
  <canvas id="universe" aria-hidden="true"></canvas>

  <div class="tint-wash" aria-hidden="true"></div>
  <div class="scrim" aria-hidden="true"></div>

  <main id="pages">
    {
      PAGES.map((page, ordinal) => (
        <section
          class={`page-panel page-${page.kind}`}
          data-page={ordinal}
          {/* The nav item this section belongs to, matched by href so the two
              lists cannot drift apart. The hero belongs to none. */}
          data-nav={page.href ?? (page.kind === 'contact' ? '#contact' : undefined)}
          id={page.kind === 'contact' ? 'contact' : page.key}
        >
          <div class="station-inner">
            {page.kind === 'hero' && (
              <>
                <img
                  class="hero-portrait"
                  src="/media/portrait.png"
                  alt="Portrait of Stefano Blando"
                  width="320"
                  height="320"
                  loading="eager"
                />
                <p class="eyebrow">
                  <span class="pip" />
                  {t('home.role')}
                </p>
                <h1>Stefano Blando</h1>
                <p class="lede">{t('home.lede')}</p>
                <p class="scroll-hint">{t('home.scroll')}</p>
              </>
            )}

            {page.kind === 'destination' && (
              <>
                <h2 class="station-title">{t(`nav.${page.key}`)}</h2>
                <a class="station-link" href={localise(page.href, lang)}>
                  {t(`station.${page.key}`)} →
                </a>
              </>
            )}

            {page.kind === 'contact' && (
              <>
                <h2 class="station-title">{t('home.contact')}</h2>
                <a class="station-link" href="mailto:stefano.blando@santannapisa.it">
                  stefano.blando@santannapisa.it →
                </a>
                <ul class="social-row" aria-label={t('home.profiles')}>
                  <li>
                    <a href={ORCID_URL}>ORCID</a>
                  </li>
                  <li>
                    <a href="https://scholar.google.com/citations?user=dNbRRG0AAAAJ">Scholar</a>
                  </li>
                  <li>
                    <a href="https://github.com/stefano-blando">GitHub</a>
                  </li>
                  <li>
                    <a href="https://www.linkedin.com/in/stefano-blando/">LinkedIn</a>
                  </li>
                </ul>
                {/* The identifier itself, not only a link to it: it is what a
                    publisher form asks you to paste. */}
                <p class="orcid-id">{ORCID}</p>
              </>
            )}
          </div>
        </section>
      ))
    }
  </main>

  {/*
    How far along the journey you are. This replaced a column of eight buttons
    that jumped to each section: at 7px they were never a real target on a
    phone, and one filling rail says the same thing more plainly.

    `aria-hidden` on purpose. The buttons were named destinations and belonged
    in a nav landmark; the rail cannot be steered, so announcing it would offer
    a control that does not exist. The masthead still names every section.
  */}
  <div class="journey-rail" aria-hidden="true">
    <span class="journey-rail-fill"></span>
  </div>

  <script>
    import universeData from '../../data/universe.json';
    import { UniverseEngine, isWebGLAvailable } from '../../engine/index.js';
    import { installSmoothScroll } from '../../engine/smooth-scroll.js';
    import { installDiagnostics, reportEnvironment, report } from '../../engine/diagnostics.js';

    installDiagnostics();

    const canvas = document.getElementById('universe');
    reportEnvironment(canvas, universeData);

    const panels = [...document.querySelectorAll('.page-panel')];
    const railFill = document.querySelector('.journey-rail-fill');

    installSmoothScroll();

    /*
     * Lighting the section you have reached in the nav.
     *
     * Driven by the same position the dots read, so the mark, the dot and the
     * shape can never disagree — an IntersectionObserver would be a second
     * opinion about which page you are on. `location` rather than `page`:
     * you are looking at that section, you are not on that page.
     */
    const navLinks = new Map(
      [...document.querySelectorAll('.masthead-nav a')].map((a) => [a.getAttribute('href'), a]),
    );
    const panelNav = panels.map((panel) => panel.dataset.nav ?? null);
    let marked = null;

    const markNav = (index) => {
      const href = panelNav[index] ?? null;
      if (href === marked) return;
      navLinks.get(marked)?.removeAttribute('aria-current');
      navLinks.get(href)?.setAttribute('aria-current', 'location');
      marked = href;
    };

    /**
     * The copy fades as its section leaves the middle of the screen, so the
     * field is uncluttered while the cloud is between two shapes.
     */
    const paint = (position) => {
      for (const [i, panel] of panels.entries()) {
        const presence = Math.max(0, 1 - Math.abs(position - i) * 1.8);
        panel.style.opacity = String(presence);
      }
      // `position` is a float across the panels, so the rail moves with the
      // scroll rather than stepping from section to section. No CSS transition
      // on the height: this runs every frame, and one would fight it.
      if (railFill) {
        const journey = panels.length > 1 ? position / (panels.length - 1) : 0;
        railFill.style.height = `${Math.min(100, Math.max(0, journey * 100))}%`;
      }
      markNav(Math.round(position));
    };

    if (!isWebGLAvailable()) {
      // No engine and no stepper: leave an ordinary readable document. The
      // sections still scroll past, so the nav still follows them — here off
      // an observer, since there is no engine to report the position.
      document.body.dataset.scene = 'off';
      report({ kind: 'fallback', reason: 'WebGL2 unavailable' });

      const seen = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) markNav(Number(entry.target.dataset.page));
          }
        },
        { rootMargin: '-45% 0px -45%', threshold: 0 },
      );
      for (const panel of panels) seen.observe(panel);
    } else {
      document.body.dataset.scene = 'on';
      try {
        new UniverseEngine({
          canvas,
          universe: universeData,
          quality: window.innerWidth < 780 ? 'low' : 'high',
          onPage: paint,
          onShape: (state) => {
            if (state.type === 'context-lost') document.body.dataset.scene = 'off';
            else report({ kind: state.type, ...state });
          },
        });

        paint(0);
      } catch (error) {
        // The page is readable without the scene; never freeze on a dead canvas.
        document.body.dataset.scene = 'off';
        report({
          kind: 'start-threw',
          message: error.message,
          stack: error.stack?.split('\n').slice(0, 8).join(' | '),
        });
      }
    }
  </script>
</Base>

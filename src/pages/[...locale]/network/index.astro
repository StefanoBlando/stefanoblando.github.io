---
import Base from '../../../layouts/Base.astro';
import CoauthorNetwork from '../../../components/CoauthorNetwork.astro';
import { useTranslations } from '../../../i18n/ui.js';
import { localePaths, alternatesFor } from '../../../i18n/routes.js';

export function getStaticPaths() {
  return localePaths();
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base
  title={t('network.title')}
  description={t('network.description')}
  scene={false}
  lang={lang}
  alternates={alternatesFor('/network/')}
>
  <main class="page page-wide">
    <CoauthorNetwork lang={lang} />
  </main>
</Base>

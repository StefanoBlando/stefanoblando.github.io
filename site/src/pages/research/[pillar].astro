---
import universe from '../../data/universe.json';
import '../../styles/palette.css';
import '../../styles/scene.css';

export function getStaticPaths() {
  return universe.clusters.map((cluster) => ({
    params: { pillar: cluster.id },
    props: { cluster },
  }));
}

const { cluster } = Astro.props;
const works = universe.nodes.filter((n) => n.cluster === cluster.id);

const publications = works.filter((w) => w.kind === 'publication');
const projects = works.filter((w) => w.kind === 'project');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#030608" />
    <title>{cluster.title} — Stefano Blando</title>
    <meta name="description" content={cluster.description} />
  </head>

  <body data-scene="on">
    <div class="tint-wash" aria-hidden="true"></div>
    <div class="scrim" aria-hidden="true"></div>

    <header class="masthead">
      <a class="wordmark" href="/">Stefano Blando<span>.</span></a>
      <p class="affiliation-line">Scuola Superiore Sant'Anna · Pisa</p>
    </header>

    <canvas id="universe" aria-hidden="true"></canvas>

    <div class="cluster-stage" data-shape={cluster.index}>
      <div class="cluster-intro">
        <p class="eyebrow">
          <span class="pip"></span>
          {String(cluster.index).padStart(2, '0')} · Research pillar
        </p>
        <h1>{cluster.title}</h1>
        <p class="lede">{cluster.description}</p>
        <ul class="topic-row">
          {cluster.topics.map((topic) => <li>{topic}</li>)}
        </ul>
        <a class="back-link" href="/">← Back to the network</a>
      </div>
    </div>

    <main class="cluster-index">
      {
        projects.length > 0 && (
          <section>
            <h2>Projects</h2>
            <ul class="work-grid">
              {projects.map((work) => (
                <li>
                  <a href={work.href}>
                    <span class="work-kind">Project</span>
                    <span class="work-title">{work.title}</span>
                    <span class="work-summary">{work.summary}</span>
                    <span class="work-tags">{work.tags.join(' · ')}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        publications.length > 0 && (
          <section>
            <h2>Publications</h2>
            <ul class="work-grid">
              {publications.map((work) => (
                <li>
                  <a href={work.href}>
                    <span class="work-kind">Paper</span>
                    <span class="work-title">{work.title}</span>
                    <span class="work-summary">{work.summary}</span>
                    <span class="work-tags">{work.tags.join(' · ')}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>

    <script>
      import universeData from '../../data/universe.json';
      import { UniverseEngine, isWebGLAvailable } from '../../engine/index.js';

      const canvas = document.getElementById('universe');

      if (isWebGLAvailable()) {
        try {
          // The stage carries this pillar's shape, so the backdrop holds its
          // topology for as long as the reader is at the top of the page.
          new UniverseEngine({
            canvas,
            universe: universeData,
            quality: window.innerWidth < 780 ? 'low' : 'high',
          });
        } catch {
          document.body.dataset.scene = 'off';
        }
      } else {
        document.body.dataset.scene = 'off';
      }
    </script>
  </body>
</html>

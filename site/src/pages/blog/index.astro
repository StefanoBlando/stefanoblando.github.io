---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date - a.data.date);

const covers = import.meta.glob('../../content/blog/*/featured.{png,jpg,jpeg,webp}', {
  eager: true,
});
const coverFor = (slug) =>
  Object.entries(covers).find(([path]) => path.includes(`/${slug}/`))?.[1]?.default;

const formatDate = (date) =>
  date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base
  title="News — Stefano Blando"
  description="Conference acceptances, awards, workshops, and recaps of talks given."
  scene={false}
>
  <main class="page page-wide">
    <header class="page-head">
      <p class="page-kicker">{posts.length} updates</p>
      <h1>News &amp; <em>recognition</em></h1>
      <p class="page-lede">
        Conference acceptances, awards, workshops, and recaps of talks given.
      </p>
    </header>

    <div class="card-grid">
      {
        posts.map((post, i) => (
          <WorkCard
            href={`/blog/${post.id}/`}
            title={post.data.title}
            summary={post.data.summary}
            tags={post.data.tags}
            image={coverFor(post.id)}
            index={i + 1}
            kind={formatDate(post.data.date)}
          />
        ))
      }
    </div>
  </main>
</Base>

---
import Base from '../../layouts/Base.astro';
import universe from '../../data/universe.json';

export function getStaticPaths() {
  return universe.clusters.map((cluster) => ({
    params: { pillar: cluster.id },
    props: { cluster },
  }));
}

const { cluster } = Astro.props;
const works = universe.nodes.filter((n) => n.cluster === cluster.id);

const publications = works.filter((w) => w.kind === 'publication');
const projects = works.filter((w) => w.kind === 'project');
---

<Base title={`${cluster.title} — Stefano Blando`} description={cluster.description} scene={false}>
  <main class="page">
    <p class="index-meta">{String(cluster.index).padStart(2, '0')} — Research pillar</p>
    <h1>{cluster.title}</h1>
    <p class="page-lede">{cluster.description}</p>

    <ul class="tag-row">
      {cluster.topics.map((topic) => <li>{topic}</li>)}
    </ul>

    {/* The long-form paragraph the homepage used to carry, now where it can be read. */}
    <p class="pillar-detail">{cluster.detailed_text}</p>

    {
      publications.length > 0 && (
        <>
          <h2 class="year-heading">Publications</h2>
          <ul class="index-list">
            {publications.map((work) => (
              <li>
                <a href={work.href}>
                  <span class="index-title">{work.title}</span>
                  <span class="index-summary">{work.summary}</span>
                </a>
                <ul class="tag-row">
                  {work.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </>
      )
    }

    {
      projects.length > 0 && (
        <>
          <h2 class="year-heading">Projects</h2>
          <ul class="index-list">
            {projects.map((work) => (
              <li>
                <a href={work.href}>
                  <span class="index-title">{work.title}</span>
                  <span class="index-summary">{work.summary}</span>
                </a>
                <ul class="tag-row">
                  {work.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <p class="back-link"><a href="/research/">← All research</a></p>
  </main>
</Base>

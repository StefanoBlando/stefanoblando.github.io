---
import Base from '../../../layouts/Base.astro';
import { collectionFor } from '../../../i18n/content.js';
import { useTranslations, localise } from '../../../i18n/ui.js';
import { localePaths, alternatesFor } from '../../../i18n/routes.js';

export function getStaticPaths() {
  return localePaths();
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const publications = (await collectionFor('publications', lang)).sort(
  (a, b) => b.data.date - a.data.date,
);

/**
 * Only links that point somewhere. `doi` and `url_pdf` are empty on every
 * publication, so an unguarded template would put six dead links on the page.
 */
const linksOf = (data) => data.links.filter((link) => link.url);

const ME = 'Stefano Blando';

const escape = (value) =>
  value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/** Joined here rather than in the template, which inserted a space before
 *  every comma: Astro preserves the whitespace between elements. */
const authorsHtml = (authors) =>
  authors
    .map((name) =>
      name === ME ? `<span class="is-me">${escape(name)}</span>` : escape(name),
    )
    .join(', ');
---

<Base
  title={t('publications.title')}
  description={t('publications.description')}
  scene={false}
  lang={lang}
  alternates={alternatesFor('/publications/')}
>
  <main class="page">
    <header class="page-head">
      <p class="page-kicker">{publications.length} {t('publications.count')}</p>
      <h1>{t('publications.headingA')} <em>{t('publications.headingB')}</em></h1>
      <p class="page-lede">{t('publications.lede')}</p>
    </header>

    <ul class="record-list">
      {
        publications.map((entry) => (
          <li class="record">
            <span class="record-year">{entry.data.date.getFullYear()}</span>
            <div>
              <a class="record-title" href={localise(`/publications/${entry.id}/`, lang)}>
                {entry.data.title}
              </a>
              <p class="record-venue">{entry.data.venue}</p>
              <p class="record-authors" set:html={authorsHtml(entry.data.authors)} />
              <div class="record-meta">
                <span class="record-type">{entry.data.type}</span>
                {linksOf(entry.data).length > 0 && (
                  <ul class="record-links">
                    {linksOf(entry.data).map((link) => (
                      <li>
                        <a href={link.url}>{link.name ?? 'Link'}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

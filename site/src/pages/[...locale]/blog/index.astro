---
import Base from '../../../layouts/Base.astro';
import WorkCard from '../../../components/WorkCard.astro';
import { collectionFor } from '../../../i18n/content.js';
import { useTranslations, localise } from '../../../i18n/ui.js';
import { localePaths, alternatesFor } from '../../../i18n/routes.js';

export function getStaticPaths() {
  return localePaths();
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await collectionFor('blog', lang)).sort((a, b) => b.data.date - a.data.date);

const covers = import.meta.glob('../../../content/blog/*/featured.{png,jpg,jpeg,webp}', {
  eager: true,
});
const coverFor = (slug) =>
  Object.entries(covers).find(([path]) => path.includes(`/${slug}/`))?.[1]?.default;

/** Dates read in the language of the page, not in the language of the build. */
const LOCALES = { en: 'en-GB', it: 'it-IT' };
const formatDate = (date) =>
  date.toLocaleDateString(LOCALES[lang], { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base
  title={t('blog.title')}
  description={t('blog.description')}
  scene={false}
  lang={lang}
  alternates={alternatesFor('/blog/')}
>
  <main class="page page-wide">
    <header class="page-head">
      <p class="page-kicker">{posts.length} {t('blog.count')}</p>
      <h1>{t('blog.headingA')} <em>{t('blog.headingB')}</em></h1>
      <p class="page-lede">{t('blog.lede')}</p>
    </header>

    <div class="card-grid">
      {
        posts.map((post, i) => (
          <WorkCard
            href={localise(`/blog/${post.id}/`, lang)}
            title={post.data.title}
            summary={post.data.summary}
            tags={post.data.tags}
            image={coverFor(post.id)}
            index={i + 1}
            kind={formatDate(post.data.date)}
          />
        ))
      }
    </div>
  </main>
</Base>

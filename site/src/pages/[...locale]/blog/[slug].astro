---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);


const covers = import.meta.glob('../../content/blog/*/featured.{png,jpg,jpeg,webp}', {
  eager: true,
});
const cover = Object.entries(covers).find(([path]) => path.includes(`/${post.id}/`))?.[1]?.default;

const formatDate = (date) =>
  date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={`${post.data.title} — Stefano Blando`} description={post.data.summary} scene={false}>
  <main class="page">
    <p class="index-meta">{formatDate(post.data.date)}</p>
    <h1>{post.data.title}</h1>
    <p class="page-lede">{post.data.summary}</p>

    <ul class="tag-row">
      {post.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>

    {
      cover && (
        <figure class="detail-cover">
          <Image src={cover} alt="" widths={[720, 1440]} sizes="(max-width: 900px) 92vw, 62rem" />
        </figure>
      )
    }

    <article class="prose"><Content /></article>

    <p class="back-link"><a href="/blog/">← All news</a></p>
  </main>
</Base>

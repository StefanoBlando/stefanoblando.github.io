---
import Base from '../layouts/Base.astro';
import universe from '../data/universe.json';
import { buildJourney, pagesOf } from '../engine/journey.js';

/**
 * The homepage is a walk through the graph, one page at a time.
 *
 * Two or three gestures advance a page; the flight between them travels the
 * legs of the walk and always takes the same time. The pages are stacked in
 * one place and cross-faded by the engine, because there is no scrolling
 * document any more — handing the pace of the animation to the wheel is what
 * made it read as chaos.
 *
 * Every page is in the markup and readable without JavaScript: a crawler, or
 * a visitor whose engine failed, gets all the destinations as a plain list.
 */
const JOURNEY = buildJourney(universe);
const PAGES = pagesOf(JOURNEY).map((index) => ({ ...JOURNEY[index], index }));
---

<Base
  title="Stefano Blando — AI Researcher & PhD Candidate"
  description="PhD candidate at Scuola Superiore Sant'Anna. Adaptive multi-agent systems, statistical verification, robust quantitative methods, and language models for economic and financial systems."
  scene={true}
  anchorBase=""
>
  <!-- Fixed backdrop. It carries no text and nothing in it is clickable. -->
  <canvas id="universe" aria-hidden="true"></canvas>

  <div class="tint-wash" aria-hidden="true"></div>
  <div class="scrim" aria-hidden="true"></div>

  <main id="pages">
    {
      PAGES.map((page, ordinal) => (
        <section
          class={`page-panel page-${page.kind}`}
          data-page={ordinal}
          id={page.kind === 'contact' ? 'contact' : page.label?.toLowerCase()}
        >
          <div class="station-inner">
            {page.kind === 'hero' && (
              <>
                <p class="eyebrow">
                  <span class="pip" />
                  AI Researcher &amp; PhD Candidate
                </p>
                <h1>Stefano Blando</h1>
                <p class="lede">
                  Adaptive multi-agent systems, statistical verification, and robust
                  quantitative methods for economic and financial systems.
                </p>
                <p class="scroll-hint">Scroll to travel</p>
              </>
            )}

            {page.kind === 'destination' && (
              <>
                <p class="station-index">{String(ordinal).padStart(2, '0')}</p>
                <h2 class="station-title">{page.label}</h2>
                <a class="station-link" href={page.href}>
                  {page.cta} →
                </a>
              </>
            )}

            {page.kind === 'contact' && (
              <>
                <p class="station-index">{String(ordinal).padStart(2, '0')}</p>
                <h2 class="station-title">Contact</h2>
                <a class="station-link" href="mailto:stefano.blando@santannapisa.it">
                  stefano.blando@santannapisa.it →
                </a>
                <ul class="social-row" aria-label="Social profiles">
                  <li>
                    <a href="https://github.com/stefano-blando">GitHub</a>
                  </li>
                  <li>
                    <a href="https://www.linkedin.com/in/stefano-blando/">LinkedIn</a>
                  </li>
                  <li>
                    <a href="https://scholar.google.com/citations?user=dNbRRG0AAAAJ">Scholar</a>
                  </li>
                </ul>
              </>
            )}
          </div>
        </section>
      ))
    }
  </main>

  <nav class="page-dots" aria-label="Journey">
    {
      PAGES.map((page, ordinal) => (
        <button
          type="button"
          class="page-dot"
          data-goto={ordinal}
          aria-label={page.label ?? (page.kind === 'hero' ? 'Start' : 'Contact')}
        />
      ))
    }
  </nav>

  <script>
    import universeData from '../data/universe.json';
    import { UniverseEngine, isWebGLAvailable } from '../engine/index.js';
    import { installDiagnostics, reportEnvironment, report } from '../engine/diagnostics.js';

    installDiagnostics();

    const canvas = document.getElementById('universe');
    reportEnvironment(canvas, universeData);

    const panels = [...document.querySelectorAll('.page-panel')];
    const dots = [...document.querySelectorAll('.page-dot')];

    /**
     * A page is fully present only once the flight has arrived. Halfway
     * between two, both are gone and the field has the screen to itself,
     * which is the point of travelling.
     */
    const paint = (position) => {
      for (const [i, panel] of panels.entries()) {
        const presence = Math.max(0, 1 - Math.abs(position - i) * 2.4);
        panel.style.opacity = String(presence);
        panel.style.transform = `translateY(${(i - position) * 42}px)`;
        panel.style.pointerEvents = presence > 0.6 ? 'auto' : 'none';
        panel.setAttribute('aria-hidden', presence > 0.6 ? 'false' : 'true');
      }
      for (const [i, dot] of dots.entries()) {
        dot.classList.toggle('is-current', Math.round(position) === i);
      }
    };

    if (!isWebGLAvailable()) {
      // No engine and no stepper: leave an ordinary readable document.
      document.body.dataset.scene = 'off';
      report({ kind: 'fallback', reason: 'WebGL2 unavailable' });
    } else {
      document.body.dataset.scene = 'on';
      try {
        const engine = new UniverseEngine({
          canvas,
          universe: universeData,
          quality: window.innerWidth < 780 ? 'low' : 'high',
          onPage: paint,
          onShape: (state) => {
            if (state.type === 'context-lost') document.body.dataset.scene = 'off';
            else report({ kind: state.type, ...state });
          },
        });

        paint(0);

        for (const dot of dots) {
          dot.addEventListener('click', () => engine.goToPage(Number(dot.dataset.goto)));
        }

        // The masthead's two anchors are pages now, not places to scroll to.
        for (const link of document.querySelectorAll('a[href^="#"]')) {
          link.addEventListener('click', (event) => {
            const target = document.getElementById(link.getAttribute('href').slice(1));
            const ordinal = panels.indexOf(target);
            if (ordinal < 0) return;
            event.preventDefault();
            engine.goToPage(ordinal);
          });
        }
      } catch (error) {
        // The page is readable without the scene; never freeze on a dead canvas.
        document.body.dataset.scene = 'off';
        report({
          kind: 'start-threw',
          message: error.message,
          stack: error.stack?.split('\n').slice(0, 8).join(' | '),
        });
      }
    }
  </script>
</Base>
